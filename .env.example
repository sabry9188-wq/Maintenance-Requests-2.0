# Copy this file to .env.local and fill in the real values from your Supabase project.
# Settings -> API in your Supabase project dashboard.
# NEVER commit .env.local to git - it is already excluded in .gitignore.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" / "publishable" key - safe to expose in the browser, RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET "service_role" key - full admin access, bypasses all security rules.
# Only used server-side to invite users (Settings -> API Keys -> Secret keys in Supabase).
# Never expose this in the browser. Do NOT add the NEXT_PUBLIC_ prefix to it.
SUPABASE_SERVICE_ROLE_KEY=
